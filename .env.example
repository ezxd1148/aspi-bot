# ── Tally ──────────────────────────────────────────────────────────────────────
TALLY_API_KEY=your_tally_api_key
FORM_ID=your_tally_form_id

# ── Telegram ────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
# Channel / group where confessions are broadcast. Use a TEST channel while validating.
TELEGRAM_CHANNEL_ID=-1001234567890
# Shared review destination. Uncomment and replace with your actual negative group ID.
# Run /start@YourBotUsername in the group to get its ID.
# The bot must be a group administrator. Only the owner/group admins can review.
# This takes priority over ADMIN_CHAT_ID; an invalid value stops startup.
# ADMIN_GROUP_ID=-1001234567890
# Legacy fallback ONLY when ADMIN_GROUP_ID is absent. Group or private chat ID.
ADMIN_CHAT_ID=123456789

# ── Poll / scheduling ────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=300
# Hour (server local time) for the daily Tally wipe. Pending/processed state is
# cleared; the dashboard audit log is retained.
RESET_HOUR=3

# ── Optional: AI moderation ───────────────────────────────────────────────────
# Chain: OpenRouter -> Groq -> NVIDIA -> DeepSeek (paid last resort).
# Groq free access requires a Free-plan account; billing follows your account plan.
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=

# ── Optional ───────────────────────────────────────────────────────────────────
# Override the data dir (processed IDs, pending reviews, dashboard audit log).
# DATA_DIR=/path/to/data
# Health-check port for Render/EC2. Default: 8080
PORT=8080

# ── Optional: admin dashboard ────────────────────────────────────────────────
# Leave DASHBOARD_URL empty to keep the dashboard disabled.
# Use a real HTTPS subdomain pointing to EC2, with Caddy terminating HTTPS.
# The dashboard binds ONLY to 127.0.0.1; do not expose port 8081 publicly.
DASHBOARD_URL=
DASHBOARD_PORT=8081
# BotFather > your bot > Login Widget: register your dashboard origin and
# https://admin.example.com/auth/callback; keep signing algorithm RS256.
# These are the Login Client ID/Secret, NOT the Telegram bot token.
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=

# ── Webhook (EC2 + Cloudflare Tunnel) ─────────────────────────────────────────
# MODE: "polling" (default, local testing) or "webhook" (EC2 prod behind cloudflared).
# In webhook mode, cloudflared forwards yourdomain.com/telegram and /tally to localhost:PORT.
MODE=polling
# Public base URL Telegram posts updates to (no trailing slash). Required in webhook mode.
WEBHOOK_URL=https://bot.odenggggg.xyz
# Shared secret for the Telegram webhook (X-Telegram-Bot-Api-Secret-Token). Set to a long random value.
WEBHOOK_SECRET=
# Shared secret Tally sends as ?secret= when it POSTs submissions to /tally.
TALLY_WEBHOOK_SECRET=
